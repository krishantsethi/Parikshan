# Never commit credentials. Configure separate Development/Preview/Production resources.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/DATABASE?sslmode=require"
# Optional direct (non-pooler) URL for CLI migrations, not used by the app.
DIRECT_URL=""
# Run: openssl rand -base64 48; paste the output into your local/Vercel environment.
SESSION_SECRET="REPLACE_ME_WITH_RANDOM_SECRET"

# Private S3-compatible bucket; enable encryption at rest and block public access.
S3_BUCKET="REPLACE_ME"
S3_REGION="REPLACE_ME"
# Empty for AWS S3; R2: https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID="REPLACE_ME"
S3_SECRET_ACCESS_KEY="REPLACE_ME"
S3_FORCE_PATH_STYLE="false"

# Vercel function payload limit is 4.5 MB including multipart overhead.
# Client and server share this public non-secret setting; capped at 4 MB.
NEXT_PUBLIC_MAX_UPLOAD_MB="4"

# ── AI provider ─────────────────────────────────────────────────────────────
# Leave empty to use the built-in MockHealthAIProvider (fully working, no keys).
# Supported values once a key is present: "mock" | "openai" | "gemini" | "azure-openai"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# ── OCR provider ────────────────────────────────────────────────────────────
# Leave empty to use the built-in MockOCRProvider (fully working, no keys).
# Supported values once a key is present: "mock" | "tesseract" | "google-vision" | "azure-vision" | "aws-textract"
OCR_PROVIDER="mock"
GOOGLE_VISION_API_KEY=""
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# ── Drug interaction provider ───────────────────────────────────────────────
# "demo" uses the seeded local dataset. "rxnav" calls the public NLM API below.
INTERACTION_PROVIDER="demo"
RXNAV_BASE_URL="https://rxnav.nlm.nih.gov/REST"

# ── ABDM / ABHA ─────────────────────────────────────────────────────────────
# DEMO ONLY. Official ABHA authentication requires approved ABDM integration
# (sandbox client id/secret + consent artefacts). No requests are made in demo.
ABDM_MODE="demo"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BASE_URL=""
